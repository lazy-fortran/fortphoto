#!/bin/sh
# The runner image has no libpng or libjpeg-turbo: take them from conda-forge
# into a prefix kept between checks, then run the tests against it.
set -eu
version=2.10.0-0
root=${TMPDIR:-/tmp}/fortphoto-deps-$version
if [ ! -e "$root/env/lib/libturbojpeg.so" ]; then
    mkdir -p "$root"
    curl -fsSL -o "$root/micromamba" \
        "https://github.com/mamba-org/micromamba-releases/releases/download/$version/micromamba-linux-64"
    chmod 755 "$root/micromamba"
    MAMBA_ROOT_PREFIX=$root/mamba "$root/micromamba" create -y -q -p "$root/env" \
        -c conda-forge libpng libjpeg-turbo
fi
export LIBRARY_PATH="$root/env/lib${LIBRARY_PATH:+:$LIBRARY_PATH}"
export LD_LIBRARY_PATH="$root/env/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export CPATH="$root/env/include${CPATH:+:$CPATH}"
fo test "$@"
